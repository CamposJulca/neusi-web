# ──────────────────────────────────────────────────────────────────────────
# NEUSI Web — Variables de entorno (PLANTILLA)
# Copia este archivo a `.env` y rellena los valores reales.
#   cp .env.example .env
# El archivo `.env` está en .gitignore: NUNCA se sube al repositorio.
# ──────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────
# Clave secreta de Django. Genera una nueva para producción, por ejemplo:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-secreta

# Modo debug. SIEMPRE False en producción.
DJANGO_DEBUG=False

# Hosts permitidos (separados por coma). Incluye tus dominios de Cloudflare.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,neusisolutions.com,www.neusisolutions.com

# Orígenes de confianza para CSRF (con esquema https://, separados por coma).
DJANGO_CSRF_TRUSTED_ORIGINS=https://neusisolutions.com,https://www.neusisolutions.com

# Ruta de la BD SQLite DENTRO del contenedor. En docker-compose se fija a
# /data/db.sqlite3 (volumen persistente); no hace falta tocarla aquí.
# DJANGO_DB_PATH=/data/db.sqlite3

# ── Correo (SMTP Office365, para el formulario de contacto) ───────────────
SMTP_USER=tu-cuenta@neusisolutions.com
SMTP_PASS=tu-password-o-app-password

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────
# Token del túnel creado en el dashboard de Cloudflare
# (Zero Trust → Networks → Tunnels → tu túnel → Install connector → copia el token).
TUNNEL_TOKEN=pega-aqui-el-token-del-tunel

# ── (Opcional) Imagen base de Node para el build del frontend ─────────────
# Por defecto node:22-alpine. Si el build falla por musl, usa:
# NODE_IMAGE=node:22-slim
